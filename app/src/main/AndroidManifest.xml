<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.live_tv"
        android:required="false" />

    <!-- Only to list the owner's own pictures in the avatar picker. Nothing is uploaded. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Without this the system refuses the uninstall request outright. The dialog is still
         the system's own, so nothing is removed without the owner confirming it there. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Lets the hero read the TV's own Continue watching list, which is how an app says where
         the owner had got to. Granted by the owner from the hero, never asked for on start.
         Orbit only reads it, and what it reads never leaves the TV. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />

    <!-- Only to fetch the artwork an app points at. Every app here but the media server
         publishes its pictures as https links rather than through a provider, so without this
         the hero would show a title over a black rectangle. Orbit sends nothing, uploads
         nothing, and never logs a link: an app's own URI can carry the owner's server in it. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- From Android 11 an app only sees the other apps it declares an interest in. Without
         this Orbit would see just a handful of system apps: the owner's own apps would vanish
         from the rows and the picker, and the Play Store and All inputs buttons with them.
         MAIN matches every launcher entry, the TV's own and the leanback ones alike. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <intent>
            <action android:name="com.android.tv.action.VIEW_INPUTS" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:requestLegacyExternalStorage="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_orbit_mark"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbit">

        <activity
            android:name=".InputPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbit" />

        <activity
            android:name=".AppPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbit" />

        <activity
            android:name=".AvatarPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.Orbit" />

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Orbit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only door to MediaSessionManager.getActiveSessions for an app that is not the
             system: a normal app must be an enabled notification listener to call it. Orbit
             reads sessions and never looks at a notification; both callbacks are empty. -->
        <service
            android:name=".MediaWatchService"
            android:exported="false"
            android:label="@string/playback_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".HomeButtonService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>
    </application>
</manifest>
